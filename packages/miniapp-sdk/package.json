{
  "name": "@farcaster/miniapp-sdk",
  "version": "0.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farcasterxyz/miniapps.git",
    "directory": "packages/miniapp-sdk"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "default": "./dist/solana.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "pnpm build:cjs && pnpm build:umd",
    "build:cjs": "tsc",
    "build:umd": "node scripts/build.js",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@farcaster/tsconfig": "workspace:*",
    "@solana/web3.js": "^1.98.2",
    "esbuild": "^0.25.0",
    "mipd": "^0.0.7",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@farcaster/miniapp-core": "workspace:*",
    "@farcaster/quick-auth": "^0.0.6",
    "comlink": "^4.4.2",
    "eventemitter3": "^5.0.1",
    "ox": "^0.14.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.2"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  }
}
