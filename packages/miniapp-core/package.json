{
  "name": "@farcaster/miniapp-core",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farcasterxyz/miniapps.git",
    "directory": "packages/miniapp-core"
  },
  "main": "dist/index.js",
  "module": "esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./solana": {
      "import": {
        "types": "./esm/solanaWire.d.ts",
        "default": "./esm/solanaWire.js"
      },
      "require": {
        "types": "./dist/solanaWire.d.ts",
        "default": "./dist/solanaWire.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist esm",
    "prebuild": "npm run clean",
    "build": "pnpm build:cjs & pnpm build:esm",
    "build:cjs": "tsc -p tsconfig.node.json",
    "build:esm": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "files": [
    "dist",
    "esm",
    "src"
  ],
  "devDependencies": {
    "@farcaster/tsconfig": "workspace:*",
    "@solana/web3.js": "^1.98.2",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "ox": "^0.14.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.2"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
